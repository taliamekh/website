# Gemini API key — get one at https://aistudio.google.com/apikey
# Set this in Vercel dashboard: Settings > Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here

# Private Workspace access. Use a long unique password and a separate 32+ character secret.
WORKSPACE_PASSWORD=your_workspace_password_here
WORKSPACE_AUTH_SECRET=your_workspace_hmac_secret_here

# Google Calendar: Web application OAuth credentials, kept server-side.
# Enable the Calendar API; add this exact authorized redirect URI to the client.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://mekh.ca/api/google-calendar?action=callback
# Optional dedicated 32+ character cookie key; defaults to the Workspace key
# with a separate purpose-derived encryption key.
GOOGLE_CALENDAR_COOKIE_SECRET=
