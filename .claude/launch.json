{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Static — Node serve",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-p", "8000", "."],
      "port": 8000
    },
    {
      "name": "Static — Python HTTP",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080"],
      "port": 8080
    },
    {
      "name": "Vercel Dev (full site + Gemini API) — needs `vercel login`",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vercel", "dev", "--listen", "3000"],
      "port": 3000
    }
  ]
}
