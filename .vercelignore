# sift is pulled in as a git subtree from taliamekh/sift. The standalone repo
# also ships the original Express server, Chrome extension, build scripts, and
# its own package.json — none of which belong on mekh.ca/sift/. Keep them in
# git (so subtree push/pull stay clean) but skip them from the deploy.
sift/server
sift/extension
sift/scripts
sift/package.json
sift/package-lock.json
sift/.claude

# expenses is a git subtree of taliamekh/expenses (PRIVATE repo). The
# spending-tracker SPA is built by Vercel at deploy time; statements-backup
# contains personal financial documents that must NEVER ship to Vercel.
# Source files under spending-tracker/src must stay in the upload so Vercel
# can build them — Vercel-side URL rewrites map /expenses/* to the built
# dist/ output, so source files aren't reachable by HTTP.
expenses/statements-backup
expenses/spending-tracker/.claude
expenses/spending-tracker/eslint.config.js
expenses/spending-tracker/README.md

# serve.json configures the local `npx serve` preview only (disables cleanUrls
# so /portal.html is served directly, matching Vercel). Not a Vercel config.
serve.json

# Internal maintenance docs (EDIT-PLAYBOOK.md etc.) — keep out of the public deploy.
docs
